# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env
# Ne jamais versionner le fichier .env (il est dans .gitignore).

# --- Stack ELK ---
ELASTIC_VERSION=8.15.3
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGS_INDEX_PREFIX=logs-ecommerce

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_URI=mongodb://admin:change-me@mongodb:27017/log_monitoring?authSource=admin

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Application Flask ---
FLASK_SECRET_KEY=change-me-with-a-long-random-string
UPLOAD_FOLDER=/app/uploads
MAX_UPLOAD_MB=100

# --- Notifications (module d'alerting) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=equipe-tech@example.com
WEBHOOK_URL=

# --- Compte administrateur créé au premier démarrage (à changer) ---
ADMIN_EMAIL=admin@ecommerce.tn
ADMIN_PASSWORD=Admin@2026

# --- Sections visibles dans Swagger UI (/api/docs) : liste séparée par des virgules, ou « all » ---
API_DOCS_SECTIONS=all
